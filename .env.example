# PrivLink 配置模板
# 复制为 .env 后按需修改（.env 已被 git 忽略，不会入库）。
# 两种部署方式共用本文件：
#   - 源码部署：服务启动时自动加载项目根目录的 .env（真实环境变量优先）
#   - Docker Compose：compose 自动读取同目录 .env 做变量替换
# 通用默认体验：只需配置 NAV_TOKEN，其余全部可留空。

# ===== 核心配置 =====

# 访问 token：非空时启用门禁（全部 /api/* 需请求头 X-Nav-Token 一致）；
# 留空 = 开放模式（无鉴权，浏览器采集接口禁用）。建议 32 位以上随机串：
#   openssl rand -hex 24
NAV_TOKEN=

# 体系模式：single（单用户，默认）；multi 为多用户预留值（暂未实现）
NAV_MODE=single

# ===== 可选：抓取增强（无代理/内网直连需求时可全部留空，抓不到的站点用浏览器采集器上报） =====

# 服务端抓取目标网站时使用的代理（标准变量；公网 IP 查询始终直连不走代理）
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost,::1

# 主机解析映射：仅改 TCP 目标 IP、保留 Host/SNI，用于内网直连自有域名（NAT 回环场景）
# 示例：NAV_HOST_ALIASES=*.example.com=192.168.1.10
NAV_HOST_ALIASES=

# SSRF 白名单：允许服务端抓取的内网网段，逗号分隔；默认全禁内网（最安全）
# 示例：NAV_ALLOWED_PRIVATE_NETWORKS=192.168.1.0/24
NAV_ALLOWED_PRIVATE_NETWORKS=

# 抓取目标网站时的 UA 与语言头，留空使用内置默认：
#   UA 默认伪装为 Windows 桌面版 Chrome 126：
#     Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
#   语言头默认中文优先：zh-CN,zh;q=0.9,en;q=0.8（影响目标网站返回的标题语言）
NAV_USER_AGENT=
NAV_ACCEPT_LANGUAGE=

# ===== 可选：Docker 构建 =====

# 构建基础镜像：留空使用官方源 ghcr.io/astral-sh/uv:python3.12-bookworm-slim；
# 拉取官方镜像困难时可指向自己的代理/镜像仓库地址（仅 docker compose build 时生效）
# 示例：DOCKER_BASE_IMAGE=registry.example.com/astral-sh/uv:python3.12-bookworm-slim
DOCKER_BASE_IMAGE=
