.uv_cache
.pytest_cache
.claude

# 本机私有文件（.gitignore 已声明不入库，防 NAV_TOKEN 等随上下文发给 daemon）
AGENTS.md
.env

# 构建配置本身无需参与上下文（builder 会单独读取 Dockerfile）
Dockerfile
docker-compose.yml
.dockerignore
.gitignore
.env.example
.python-version
