{
  "bridgeVersion": 1,
  "plugins": [
    {
      "id": "sticky-notes",
      "name": "便签",
      "version": "1.2.3",
      "description": "在导航页添加便签，支持基础 Markdown（行内代码、列表、任务列表、块引用），可浮动、拖拽移动与缩放；数据经宿主桥保存在本服务。",
      "author": "luis",
      "slot": "float",
      "entry": "index.html",
      "permissions": ["storage"]
    },
    {
      "id": "poly-gradient",
      "name": "多边形渐变",
      "version": "1.1.0",
      "description": "多点光源 + 低多边形网格渐变，支持 PC/移动端尺寸、PNG 下载与设为背景。",
      "author": "luis",
      "slot": "float",
      "entry": "index.html",
      "permissions": ["export"],
      "defaultSize": { "w": 1000, "h": 720 },
      "singleton": true,
      "autoOpen": false,
      "launchLabel": "创建图片",
      "backgroundLabel": "自定义渐变"
    },
    {
      "id": "anniversary",
      "name": "纪念日",
      "version": "0.2.0",
      "description": "月历选择公历/农历纪念日，双历法各自推算最近一次发生日并倒计时；闰月与小月自动回退。",
      "author": "luis",
      "slot": "float",
      "entry": "index.html",
      "permissions": ["storage"],
      "defaultSize": { "w": 400, "h": 600 },
      "singleton": true,
      "globalStorage": true
    }
  ]
}
