{
  "name": "privlink-cloudflare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "python ../../scripts/sync-frontend.py && wrangler deploy",
    "sync:assets": "python ../../scripts/sync-frontend.py",
    "db:migrate": "wrangler d1 execute privlink --file=migrations/001_init.sql",
    "icons:fetch": "python ../../scripts/fetch-simple-icons.py && python ../../scripts/sync-frontend.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "hono": "^4.5.0",
    "typescript": "^5.5.0",
    "vitest": "^1.3.0",
    "wrangler": "^4.124.0"
  }
}
